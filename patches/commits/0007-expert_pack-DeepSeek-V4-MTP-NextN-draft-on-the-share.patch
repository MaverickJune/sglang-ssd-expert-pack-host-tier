+class ExpertPackMtpAttachTest(unittest.TestCase):
+    """A 1-layer MTP pack is indexed as logical layer num_layers of the main pack."""
+
+    def test_attached_mtp_pack_is_read_as_extra_layer(self):
+        import os
+
+        with tempfile.TemporaryDirectory() as root:
+            (Path(root) / "main").mkdir()
+            (Path(root) / "mtp").mkdir()
+            main_pack, main_manifest, digests = _make_pack(Path(root) / "main")
+            mtp_pack, mtp_manifest, _ = _make_pack(Path(root) / "mtp")
+            store = ExpertPackStore(
+                main_pack,
+                manifest_path=main_manifest,
+                expected_layers=1,
+                expected_experts=2,
+                expected_top_k=1,
+                expected_source_sha256=digests["source"],
+                expected_model_identity_sha256=digests["model_identity"],
+                expected_config_sha256=digests["config"],
+                cache_vram_mib=1,
+                stage_slots=1,
+                mtp_pack_path=mtp_pack,
+                mtp_manifest_path=mtp_manifest,
+            )
+            try:
+                self.assertEqual(store.mtp_layer_id, 1)
+                self.assertEqual(store.active_moe_layer_ids, frozenset({0, 1}))
+                self.assertEqual(len(store.entries), 12)
+                self.assertEqual(len(store._route_calls_by_layer), 2)
+                staging = torch.zeros(store.object_payload_bytes, dtype=torch.uint8)
+                for expert in range(2):
+                    for layer in (0, 1):
+                        read_bytes, _ = store._read_object_range(
+                            layer, expert, staging, start=0, length=store.object_payload_bytes
+                        )
+                        self.assertEqual(read_bytes, store.object_payload_bytes)
+                        expected = b"".join(
+                            bytes([expert * 3 + role_id]) * store.role_bytes for role_id in range(3)
+                        )
+                        self.assertEqual(bytes(staging.numpy()[: len(expected)]), expected)
+                self.assertNotEqual(store._fd_by_layer[1], store._fd)
+                # the MTP file is a different file from the main pack
+                self.assertNotEqual(
+                    os.fstat(store._fd_by_layer[1]).st_ino, os.fstat(store._fd).st_ino
+                )
+            finally:
+                store.close()
+            self.assertEqual(store._fd_by_layer, {})
+
+    def test_mtp_pack_stride_mismatch_is_rejected(self):
+        with tempfile.TemporaryDirectory() as root:
+            (Path(root) / "main").mkdir()
+            (Path(root) / "mtp").mkdir()
+            main_pack, main_manifest, digests = _make_pack(Path(root) / "main")
+            mtp_pack, mtp_manifest, _ = _make_pack(Path(root) / "mtp")
+            manifest = json.loads(mtp_manifest.read_text())
+            manifest["object_stride"] = manifest["object_stride"] * 2
+            bad = Path(root) / "bad.manifest.json"
+            bad.write_text(json.dumps(manifest))
+            with self.assertRaises(ValueError):
+                ExpertPackStore(
+                    main_pack,
+                    manifest_path=main_manifest,
+                    expected_layers=1,
+                    expected_experts=2,
+                    expected_top_k=1,
+                    cache_vram_mib=1,
+                    stage_slots=1,
+                    mtp_pack_path=mtp_pack,
+                    mtp_manifest_path=bad,
+                )
